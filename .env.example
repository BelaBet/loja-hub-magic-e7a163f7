# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe Pagar.me public key — used only for card tokenization.
# The checkout domain must also be authorized in the Pagar.me dashboard.
VITE_PAGARME_PUBLIC_KEY=

# Server-side only — NEVER expose these in VITE_* variables
PAGARME_SECRET_KEY=
PAGARME_PLATFORM_RECIPIENT_ID=
SUPABASE_SERVICE_ROLE_KEY=
